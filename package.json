{
  "name": "ai-bid-response-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "backend:dev": "npm run dev -w backend",
    "frontend:dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
